        "result_tail": "1\texport function formatTitle(title, author) {\n2\t  return `${title.trim()} by ${author.trim()}`;\n3\t}\n4\t\n5\texport function slugify(text) {\n6\t  return text.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n7\t}\n8\t\n9\texport function averageRating(ratings) {\n10\t  if (ratings.length === 0) return 0;\n11\t  return ratings.reduce((sum, r) => sum + r, 0) / ratings.length;\n12\t}\n13\t"
