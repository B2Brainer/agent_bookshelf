+<% if (books.length === 0) { %>
+  <p class="empty-state">No books match your search.</p>
+<% } else { %>
+  <div class="book-grid">
+    <% books.forEach(book => { %>
+      <div class="book-card">
+        <h2><a href="/books/<%= book.id %>"><%= book.title %></a></h2>
+        <p class="author">by <%= book.author %></p>
+        <% if (book.published_year) { %>
+          <p class="year"><%= book.published_year %></p>
+        <% } %>
+      </div>
+    <% }) %>
+  </div>
+<% } %>
diff --git a/tests/models/search.test.ts b/tests/models/search.test.ts
new file mode 100644
index 0000000..66b109a
--- /dev/null
+++ b/tests/models/search.test.ts
@@ -0,0 +1,144 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { readFileSync } from 'fs';
+import { initDb, closeDb } from '../../src/db/index.js';
+import * as Book from '../../src/models/book.js';
+
+beforeEach(async () => {
+  await initDb('/tmp/test-search-model.db');
+});
+
+afterEach(() => {
+  closeDb();
+  const fs = require('fs');
+  try {
+    fs.unlinkSync('/tmp/test-search-model.db');
+  } catch (e) {
+    // ignore
+  }
+});
+
+describe('searchBooks model', () => {
+  describe('AC1: matches title or author, partial and case-insensitive', () => {
+    it('matches a partial title substring', () => {
+      const results = Book.searchBooks('pragmatic');
+      expect(results.map((b) => b.title)).toContain('The Pragmatic Programmer');
+    });
+
+    it('matches a partial author substring regardless of case', () => {
+      const results = Book.searchBooks('KNUTH');
+      expect(results.map((b) => b.title)).toContain('The Art of Computer Programming');
+    });
+
+    it('matches mixed-case queries', () => {
+      const results = Book.searchBooks('PraGMatiC');
+      expect(results.map((b) => b.title)).toContain('The Pragmatic Programmer');
+    });
+
+    it('returns an empty array when there is no match', () => {
+      const results = Book.searchBooks('zzzznomatchzzzz');
+      expect(results).toEqual([]);
+    });
+  });
+
+  describe('AC2: empty query returns all books, ordered by title', () => {
+    it('returns all 50 books for an empty string query', () => {
+      const results = Book.searchBooks('');
+      expect(results).toHaveLength(50);
+      expect(results[0].title).toBe(Book.getAllBooks()[0].title);
+    });
+
+    it('returns all 50 books for a whitespace-only query', () => {
+      const results = Book.searchBooks('   ');
+      expect(results).toHaveLength(50);
+    });
+
+    it('returns results in the same order as getAllBooks', () => {
+      const results = Book.searchBooks('');
+      const all = Book.getAllBooks();
+      expect(results.map((b) => b.id)).toEqual(all.map((b) => b.id));
+    });
+  });
+
+  describe('AC3: input is trimmed; over 100 characters throws SearchValidationError', () => {
+    it('trims surrounding whitespace so "  dune  " behaves like "dune"', () => {
+      const trimmed = Book.searchBooks('dune');
+      const padded = Book.searchBooks('  dune  ');
+      expect(padded.map((b) => b.id)).toEqual(trimmed.map((b) => b.id));
+    });
+
+    it('accepts a query of exactly 100 characters', () => {
+      const query = 'a'.repeat(100);
+      expect(() => Book.searchBooks(query)).not.toThrow();
+    });
+
+    it('throws SearchValidationError for a query of 101 characters', () => {
+      const query = 'a'.repeat(101);
+      expect(() => Book.searchBooks(query)).toThrow(Book.SearchValidationError);
+    });
+
+    it('throws a SearchValidationError whose message mentions 100', () => {
+      const query = 'a'.repeat(101);
+      try {
+        Book.searchBooks(query);
+        throw new Error('expected searchBooks to throw');
+      } catch (err) {
+        expect(err).toBeInstanceOf(Book.SearchValidationError);
+        expect((err as Error).message).toMatch(/100/);
+      }
+    });
+
+    it('trims before checking length: 100 chars surrounded by spaces does not throw', () => {
+      const query = `  ${'a'.repeat(100)}  `;
+      expect(() => Book.searchBooks(query)).not.toThrow();
+    });
+  });
+
+  describe('AC4: SQL is parameterised and LIKE metacharacters are not interpreted', () => {
+    it('returns an empty array for a classic injection payload without throwing', () => {
+      expect(() => {
+        const results = Book.searchBooks("' OR 1=1 --");
+        expect(results).toEqual([]);
+      }).not.toThrow();
+    });
+
+    it('returns an empty array for a second injection payload without throwing', () => {
+      expect(() => {
+        const results = Book.searchBooks("%' OR '1'='1");
+        expect(results).toEqual([]);
+      }).not.toThrow();
+    });
+
+    it('treats a bare "%" wildcard as a literal character, not "match everything"', () => {
+      const results = Book.searchBooks('%');
+      expect(results.length).toBeLessThan(50);
+    });
+
+    it('treats "_" as a literal character, not "match any single character"', () => {
+      const results = Book.searchBooks('_');
+      expect(results).toEqual([]);
+    });
+
+    it('binds the query via ? placeholders rather than interpolating it into the SQL string', () => {
+      const source = readFileSync(
+        new URL('../../src/models/book.ts', import.meta.url),
+        'utf-8'
+      );
+      const searchFnMatch = source.match(
+        /export function searchBooks[\s\S]*?\n}/
+      );
+      expect(searchFnMatch).not.toBeNull();
+      const fnBody = searchFnMatch![0];
+
+      // Find the literal SQL string(s) passed as the first argument to the db
+      // helpers (all/get/run) inside searchBooks, and assert none of them
+      // interpolate a variable directly into the SQL text.
+      const sqlArgMatches = [...fnBody.matchAll(/\b(?:all|get|run)\(\s*(`[\s\S]*?`|'[^']*'|"[^"]*")/g)];
+      expect(sqlArgMatches.length).toBeGreaterThan(0);
+      for (const match of sqlArgMatches) {
+        const sqlLiteral = match[1];
+        expect(sqlLiteral).not.toMatch(/\$\{/);
+        expect(sqlLiteral).toMatch(/\?/);
+      }
+    });
+  });
+});
