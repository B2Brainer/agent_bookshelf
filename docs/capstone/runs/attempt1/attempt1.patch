+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import app from '../../src/server.js';
+import { initDb, closeDb } from '../../src/db/index.js';
+
+beforeEach(async () => {
+  await initDb('/tmp/test-search-routes.db');
+});
+
+afterEach(() => {
+  closeDb();
+  const fs = require('fs');
+  try {
+    fs.unlinkSync('/tmp/test-search-routes.db');
+  } catch (e) {
+    // ignore
+  }
+});
+
+describe('GET /api/books/search', () => {
+  describe('AC1: matches title or author, partial and case-insensitive', () => {
+    it('matches a partial title substring', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: 'pragmatic' });
+      expect(res.status).toBe(200);
+      expect(res.body.map((b: any) => b.title)).toContain('The Pragmatic Programmer');
+      expect(res.body[0]).toHaveProperty('id');
+      expect(res.body[0]).toHaveProperty('title');
+      expect(res.body[0]).toHaveProperty('author');
+      expect(res.body[0]).toHaveProperty('isbn');
+      expect(res.body[0]).toHaveProperty('cover_url');
+      expect(res.body[0]).toHaveProperty('description');
+      expect(res.body[0]).toHaveProperty('published_year');
+      expect(res.body[0]).toHaveProperty('created_at');
+    });
+
+    it('matches a partial author substring regardless of case', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: 'KNUTH' });
+      expect(res.status).toBe(200);
+      expect(res.body.map((b: any) => b.title)).toContain('The Art of Computer Programming');
+    });
+
+    it('returns an empty array for a no-match query', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: 'zzzznomatchzzzz' });
+      expect(res.status).toBe(200);
+      expect(res.body).toEqual([]);
+    });
+  });
+
+  describe('AC2: empty/missing query returns all books in the same order as GET /api/books', () => {
+    it('returns all 50 books when q is missing', async () => {
+      const reference = await request(app).get('/api/books');
+      const res = await request(app).get('/api/books/search');
+      expect(res.status).toBe(200);
+      expect(res.body).toHaveLength(50);
+      expect(res.body.map((b: any) => b.id)).toEqual(reference.body.map((b: any) => b.id));
+    });
+
+    it('returns all 50 books when q is an empty string', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: '' });
+      expect(res.status).toBe(200);
+      expect(res.body).toHaveLength(50);
+    });
+
+    it('returns all 50 books when q is whitespace only', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: '   ' });
+      expect(res.status).toBe(200);
+      expect(res.body).toHaveLength(50);
+    });
+  });
+
+  describe('AC3: input is trimmed; over 100 characters returns 400', () => {
+    it('treats "  dune  " the same as "dune"', async () => {
+      const trimmed = await request(app).get('/api/books/search').query({ q: 'dune' });
+      const padded = await request(app).get('/api/books/search').query({ q: '  dune  ' });
+      expect(padded.status).toBe(200);
+      expect(padded.body.map((b: any) => b.id)).toEqual(trimmed.body.map((b: any) => b.id));
+    });
+
+    it('accepts exactly 100 characters with 200', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: 'a'.repeat(100) });
+      expect(res.status).toBe(200);
+    });
+
+    it('rejects 101 characters with 400 and an error mentioning 100', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: 'a'.repeat(101) });
+      expect(res.status).toBe(400);
+      expect(res.body).toHaveProperty('error');
+      expect(res.body.error).toMatch(/100/);
+    });
+
+    it('trims before the length check: 100 chars with surrounding spaces returns 200', async () => {
+      const res = await request(app)
+        .get('/api/books/search')
+        .query({ q: `  ${'a'.repeat(100)}  ` });
+      expect(res.status).toBe(200);
+    });
+  });
+
+  describe('AC4: parameterised search handles hostile/wildcard input safely', () => {
+    it('returns [] for a classic SQL injection payload without erroring', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: "' OR 1=1 --" });
+      expect(res.status).toBe(200);
+      expect(res.body).toEqual([]);
+    });
+
+    it('returns [] for a second SQL injection payload without erroring', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: "%' OR '1'='1" });
+      expect(res.status).toBe(200);
+      expect(res.body).toEqual([]);
+    });
+
+    it('treats a bare "%" as a literal character, not "match everything"', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: '%' });
+      expect(res.status).toBe(200);
+      expect(res.body.length).toBeLessThan(50);
+    });
+
+    it('treats "_" as a literal character, not "match any single character"', async () => {
+      const res = await request(app).get('/api/books/search').query({ q: '_' });
+      expect(res.status).toBe(200);
+      expect(res.body).toEqual([]);
+    });
+  });
+
+  describe('q given more than once', () => {
+    it('returns 400 when q is repeated (?q=a&q=b)', async () => {
+      const res = await request(app).get('/api/books/search?q=a&q=b');
+      expect(res.status).toBe(400);
+      expect(res.body).toHaveProperty('error');
+    });
+  });
+
+  it('is registered before GET /api/books/:id so "search" is not parsed as an id', async () => {
+    const res = await request(app).get('/api/books/search');
+    expect(res.status).not.toBe(404);
+  });
+});
+
+describe('GET /books/search (HTMX fragment)', () => {
+  it('returns 200 HTML containing a matching book title for a partial match', async () => {
+    const res = await request(app).get('/books/search').query({ q: 'dune' });
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('Dune');
+  });
+
+  it('uses the same book-grid / book-card markup as the index view', async () => {
+    const res = await request(app).get('/books/search').query({ q: 'dune' });
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('book-grid');
+    expect(res.text).toContain('book-card');
+  });
+
+  it('renders an empty-state message when there are no matches', async () => {
+    const res = await request(app).get('/books/search').query({ q: 'zzzznomatchzzzz' });
+    expect(res.status).toBe(200);
+    expect(res.text).not.toContain('book-card');
+    expect(res.text.toLowerCase()).toMatch(/no (books|results|matches)/);
+  });
+
+  it('returns all books as HTML when q is missing', async () => {
+    const res = await request(app).get('/books/search');
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('book-grid');
+  });
+
+  it('returns 400 with an error fragment for a query over 100 characters', async () => {
+    const res = await request(app).get('/books/search').query({ q: 'a'.repeat(101) });
+    expect(res.status).toBe(400);
+    expect(res.text).toContain('class="error"');
+  });
+});
